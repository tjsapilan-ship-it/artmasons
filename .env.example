# Encryption Configuration
# CRITICAL: Generate a strong random key for production
# Example: openssl rand -hex 32
# This key is used to encrypt sensitive customer data, orders, and PII
ENCRYPTION_KEY=your-strong-random-key-here-change-this-in-production

# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM=noreply@artmasons.com

# Application Configuration
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Security Headers (optional - uncomment for production)
# ENABLE_HSTS=true
# ENABLE_CSP=true
# ENABLE_X_FRAME_OPTIONS=true

# Database Configuration (if using external DB in future)
# DATABASE_URL=postgresql://user:password@localhost:5432/artmasons
# DATABASE_ENCRYPTION_KEY=your-database-specific-encryption-key

# Session Configuration (if implementing sessions)
# SESSION_SECRET=your-session-secret-here
# SESSION_TIMEOUT=86400000

# Rate Limiting (requests per minute)
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW=60000

# File Upload Limits
# MAX_FILE_SIZE=5242880
# ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# Logging Configuration
# LOG_LEVEL=info
# ENABLE_AUDIT_LOG=true
